# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Generate a random secret of 32+ characters. Keep it private.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Exact origin(s) where your SylesStacks HTML is hosted; comma-separated if needed.
# Example: https://yourname.github.io
FRONTEND_ORIGIN=https://YOUR_GITHUB_PAGES_ORIGIN

NODE_ENV=production
SESSION_DAYS=7

# Use "none" when frontend and API are on different domains (GitHub Pages + Render).
COOKIE_SAME_SITE=none
